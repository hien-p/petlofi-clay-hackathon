# Web app
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_PETLOFI_PACKAGE_ID=
NEXT_PUBLIC_PETLOFI_MODULE=petlofi
NEXT_PUBLIC_DEFAULT_PET_TEMPLATE_ID=

# Walrus publisher. If omitted, the app writes a local verifiable blob under .petlofi/walrus.
WALRUS_NETWORK=testnet
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# MemWal HTTP MCP bridge. If omitted, the app uses a local file-backed memory cache.
MEMWAL_MCP_HTTP_URL=http://localhost:3005/api/mcp
MEMWAL_BEARER_TOKEN=
MEMWAL_ACCOUNT_ID=

# Optional AI provider. If omitted, PetLofi runs a deterministic local agent loop.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2-mini
