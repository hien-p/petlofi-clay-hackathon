# Sui on-chain config (NEXT_PUBLIC_* are inlined at build time).
# Copy this file to .env.local. The IDs below are the live PetLofi testnet
# deployment (public on-chain ids, safe to commit) — replace if you republish.
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_PETLOFI_PACKAGE_ID=0x7e438921a23d7005d7479bcbbea9469570b00500a7d04b7a897c86ff02c8af2f
NEXT_PUBLIC_PETLOFI_MODULE=petlofi
NEXT_PUBLIC_DEFAULT_PET_TEMPLATE_ID=0x57acc99bcdddbf4f46cd1a0e5d36dc31dfd1cdd370a0c3fa6fff591f3fba3c00

# Optional backing services (fallback to local files if unset)
WALRUS_PUBLISHER_URL=
MEMWAL_MCP_HTTP_URL=
MEMWAL_BEARER_TOKEN=
MEMWAL_ACCOUNT_ID=
OPENAI_API_KEY=
